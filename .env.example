# Email Marketing Campaign - Environment Variables Example
# Copy this file to .env and fill in your actual values

# Email Provider Selection (gmail, sendgrid, or hostinger)
EMAIL_PROVIDER=gmail

# Gmail Configuration (Recommended for Render)
# 1. Enable 2FA on Gmail account
# 2. Generate app password: https://myaccount.google.com/apppasswords
# 3. Copy the 16-character password below
GMAIL_USER=your_email@gmail.com
GMAIL_APP_PASSWORD=your_16_char_app_password

# SendGrid Configuration (Alternative, Free tier available)
# Get API key from: https://app.sendgrid.com/settings/api_keys
SENDGRID_API_KEY=SG.your_sendgrid_api_key_here

# Hostinger SMTP Configuration (Local testing only - blocked on Render)
# 587 = STARTTLS (SMTP_SECURE=false), 465 = implicit TLS (SMTP_SECURE=true)
EMAIL_USER=your_mailbox_email@domain.com
EMAIL_PASS=your_mailbox_password_here
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=587
SMTP_SECURE=false

# Server Configuration
PORT=3000
NODE_ENV=development
